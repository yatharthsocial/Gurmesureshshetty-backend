# Railway Postgres connection string (Postgres service → "Connect" tab → "Postgres Connection URL")
DATABASE_URL="postgresql://user:password@host:port/database"

# Port the API listens on locally (Railway sets its own PORT automatically in production)
PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Cloudinary (Dashboard → Account Details) — used for grievance photo uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Long random secret used to sign admin JWTs — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
